# Copy to octocheck.config.yaml in your project root (the installer does this if it's missing).
# Use 0 or off to switch a setting off.

# Re-review a file whose last review is older than this many days, even if it hasn't changed.
# A safety net for connections between files that can't be seen by reading imports.
review_expiry_days: 19

# If one change would pull in more than this many other files for a contract check, ask first.
blast_radius_limit: 25

# Files OctoCheck never reviews: nothing in them to check, so reading them only costs tokens.
# This list replaces the built-in default if you set it, so keep the lines you still want.
# Empty files are always skipped automatically. Note: requirements.txt, package.json and
# patches.txt are deliberately NOT skipped, because some rules check them.
skip_files:
  - ".pre-commit-config.yaml"
  - ".editorconfig"
  - ".gitignore"
  - ".eslintrc*"
  - ".prettierrc*"
  - "modules.txt"
  - "*.lock"
  - "package-lock.json"
  - "*.md"
  - "LICENSE*"
  - "*.png"
  - "*.jpg"
  - "*.jpeg"
  - "*.gif"
  - "*.svg"
  - "*.ico"
  - "*.woff*"
  - "*.pdf"
  - "*.min.js"
  - "*.min.css"
  - "*.map"
  - "node_modules/**"
  - "dist/**"
  - "build/**"
  - "__pycache__/**"
